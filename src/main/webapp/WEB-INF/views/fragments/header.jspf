<%@ page import="com.moviebooking.model.User" %>
<%@ page import="com.moviebooking.model.UserRole" %>
<%@ page import="com.moviebooking.service.AuthService" %>

<!DOCTYPE html>
<html>
<head>
    <title>CineFlex</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css">
</head>

<body>

    <%
    AuthService authService = new AuthService();
    User currentUser = authService.getCurrentUser(request.getSession(false));

    boolean loggedIn = currentUser != null;
    boolean admin = loggedIn && UserRole.ADMIN.equals(currentUser.getRole());
%>

<nav class="navbar navbar-expand navbar-dark cinema-navbar">
    <div class="container">

        <a class="navbar-brand" href="${pageContext.request.contextPath}/movies">
            CineFlex
        </a>

        <div class="navbar-nav ms-auto">

            <a class="nav-link" href="${pageContext.request.contextPath}/movies">
                Movies
            </a>

            <% if (loggedIn) { %>

            <a class="nav-link" href="${pageContext.request.contextPath}/my-bookings">
                My Bookings
            </a>

            <% if (admin) { %>
            <a class="nav-link" href="${pageContext.request.contextPath}/admin">
                Admin
            </a>

            <a class="nav-link" href="${pageContext.request.contextPath}/admin/queue">
                Queue
            </a>
            <% } %>

            <a class="nav-link nav-link-danger" href="${pageContext.request.contextPath}/logout">
                Logout
            </a>

            <% } else { %>

            <a class="nav-link nav-link-danger" href="${pageContext.request.contextPath}/login">
                Login
            </a>

            <a class="nav-link" href="${pageContext.request.contextPath}/signup">
                Sign Up
            </a>

            <% } %>

        </div>
    </div>
</nav>